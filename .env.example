RESEND_API_KEY=re_your_api_key_here
PORT=3001
PORTAL_URL=https://nieeportal.firebaseapp.com
# Path to your Firebase service account JSON key (download from Firebase Console → Project Settings → Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
FIREBASE_DATABASE_URL=https://nieeportal-default-rtdb.firebaseio.com
# Paystack secret key (Dashboard → Settings → API Keys & Webhooks). Required for /api/paystack-webhook
# to verify webhook signatures and for the payment reconciliation script.
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
